<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Bài 9 · 换钱 | Ôn tập tiếng Trung</title>
<!-- Thư viện tạo animation nét vẽ -->
<script src="https://cdn.jsdelivr.net/npm/hanzi-writer@3.5/dist/hanzi-writer.min.js"></script>
<style>
/* ============ BASE ============ */
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{margin:0;padding:0;}
body{
  font-family:"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans",Arial,sans-serif;
  color:#3d3346;
  background:linear-gradient(165deg,#fdf1f7 0%,#f4efff 35%,#eaf7f4 70%,#fef6ee 100%);
  min-height:100vh;overflow-x:hidden;position:relative;
}
.bg-blob{position:fixed;border-radius:50%;filter:blur(70px);opacity:.55;pointer-events:none;z-index:0;}
.b1{width:420px;height:420px;background:#ffd3e2;top:-150px;left:-130px;animation:float1 18s ease-in-out infinite;}
.b2{width:380px;height:380px;background:#d9cbff;top:15%;right:-160px;animation:float2 22s ease-in-out infinite;}
.b3{width:460px;height:460px;background:#c3f2e2;bottom:-220px;left:15%;animation:float1 26s ease-in-out infinite reverse;}
.b4{width:280px;height:280px;background:#ffe6b8;bottom:8%;right:6%;opacity:.45;animation:float2 20s ease-in-out infinite;}
@keyframes float1{0%,100%{transform:translate(0,0) scale(1);}50%{transform:translate(30px,40px) scale(1.08);}}
@keyframes float2{0%,100%{transform:translate(0,0) scale(1);}50%{transform:translate(-35px,30px) scale(1.06);}}
body::before{
  content:'';position:fixed;inset:0;z-index:0;pointer-events:none;
  background-image:radial-gradient(#ffffffaa 1.3px,transparent 1.3px);
  background-size:28px 28px;opacity:.7;
}
.wrap{position:relative;z-index:2;max-width:1120px;margin:0 auto;padding:22px 16px 60px;}

/* ============ HERO ============ */
.hero{text-align:center;padding:14px 0 18px;}
.hero-badge{
  display:inline-block;padding:5px 16px;border-radius:999px;
  background:linear-gradient(135deg,#ffb3c6,#c9b6ff);
  color:#fff;font-weight:700;font-size:13px;letter-spacing:2px;
  box-shadow:0 6px 16px rgba(201,182,255,.45);
}
.hero h1{
  margin:12px 0 4px;font-size:clamp(30px,6vw,46px);letter-spacing:4px;
  background:linear-gradient(135deg,#ff7fa3 0%,#a98bff 50%,#57c9b0 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  font-weight:800;text-shadow:0 2px 0 rgba(255,255,255,.6);
}
.hero-sub{margin:0;color:#8a7d95;font-size:14.5px;letter-spacing:.5px;}

/* ============ TABS ============ */
.tabs{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:18px 0 20px;}
.tab{
  border:none;cursor:pointer;font-family:inherit;font-size:14.5px;font-weight:700;
  padding:10px 20px;border-radius:999px;color:#7a6b88;
  background:rgba(255,255,255,.72);
  box-shadow:0 4px 14px rgba(160,140,190,.16);
  transition:.25s;backdrop-filter:blur(8px);
}
.tab:hover{transform:translateY(-2px);color:#5d4d70;}
.tab.active{
  color:#fff;background:linear-gradient(135deg,#ff9dbb,#a98bff);
  box-shadow:0 8px 22px rgba(169,139,255,.45);
}
.panel{display:none;animation:fadeUp .35s ease;}
.panel.active{display:block;}
@keyframes fadeUp{from{opacity:0;transform:translateY(12px);}to{opacity:1;transform:translateY(0);}}

/* ============ VOCAB ============ */
.toolbar{
  display:flex;gap:14px;flex-wrap:wrap;align-items:center;justify-content:space-between;
  background:rgba(255,255,255,.72);backdrop-filter:blur(10px);
  border-radius:20px;padding:14px 18px;margin-bottom:18px;
  box-shadow:0 8px 26px rgba(180,160,210,.16);
}
.search{
  flex:1;min-width:200px;border:2px solid #f0e6f7;border-radius:14px;
  padding:10px 16px;font-size:15px;font-family:inherit;outline:none;
  background:#fff;color:#4a3f55;transition:.2s;
}
.search:focus{border-color:#c9b6ff;box-shadow:0 0 0 4px rgba(201,182,255,.2);}
.speed-control{display:flex;align-items:center;gap:10px;font-size:13.5px;color:#7a6b88;font-weight:600;}
.speed-control input[type=range]{
  -webkit-appearance:none;appearance:none;width:130px;height:6px;border-radius:99px;
  background:linear-gradient(90deg,#ffb3c6,#c9b6ff);outline:none;
}
.speed-control input[type=range]::-webkit-slider-thumb{
  -webkit-appearance:none;width:20px;height:20px;border-radius:50%;
  background:#fff;border:3px solid #a98bff;cursor:pointer;box-shadow:0 2px 8px rgba(169,139,255,.5);
}
.speed-control input[type=range]::-moz-range-thumb{
  width:20px;height:20px;border-radius:50%;background:#fff;border:3px solid #a98bff;cursor:pointer;
}
#speedVal{min-width:42px;text-align:center;color:#a98bff;font-weight:800;}

.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(238px,1fr));gap:15px;}

/* --- FLIP CARD --- */
.vcard{
  perspective:1100px;height:300px;cursor:pointer;
  -webkit-user-select:none;user-select:none;
}
.vcard-inner{
  position:relative;width:100%;height:100%;
  transform-style:preserve-3d;
  transition:transform .62s cubic-bezier(.4,.2,.2,1);
}
.vcard.flipped .vcard-inner{transform:rotateY(180deg);}
.vcard-face{
  position:absolute;inset:0;border-radius:20px;padding:16px;
  backface-visibility:hidden;-webkit-backface-visibility:hidden;
  display:flex;flex-direction:column;
  background:rgba(255,255,255,.9);backdrop-filter:blur(8px);
  border:2px solid rgba(255,255,255,.95);
  box-shadow:0 8px 22px rgba(180,160,210,.17);
  overflow:hidden;
}
.vcard-front::after{
  content:'';position:absolute;top:-45%;right:-45%;width:90%;height:90%;
  background:radial-gradient(circle,rgba(255,190,215,.4),transparent 70%);
  pointer-events:none;
}
.vcard-back{
  transform:rotateY(180deg);
  background:linear-gradient(160deg,#fff8fc,#f4f0ff);
  overflow-y:auto;overflow-x:hidden;
  padding:13px 14px 14px;
}
.vcard-back::-webkit-scrollbar{width:5px;}
.vcard-back::-webkit-scrollbar-thumb{background:#d9c9f5;border-radius:9px;}

.vcard-top{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;position:relative;z-index:1;}
.vcard-hanzi{
  font-size:29px;font-weight:800;letter-spacing:2px;line-height:1.2;
  background:linear-gradient(135deg,#ff7fa3,#9b7bff);
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.spk{
  flex:none;border:none;cursor:pointer;width:33px;height:33px;border-radius:50%;
  background:linear-gradient(135deg,#ffe3ee,#e6dcff);font-size:15px;
  display:grid;place-items:center;transition:.2s;position:relative;z-index:2;
}
.spk:hover{transform:scale(1.15);background:linear-gradient(135deg,#ffc9dd,#d3c1ff);}
.vcard-pinyin{margin-top:7px;font-size:15px;font-weight:700;color:#8b7bb8;letter-spacing:.4px;position:relative;z-index:1;}
.vcard-mean{margin-top:5px;font-size:13.5px;color:#8d8298;line-height:1.45;position:relative;z-index:1;flex:1;}
.vcard-hint{
  font-size:11.5px;color:#c0aee0;font-weight:700;letter-spacing:.3px;
  display:flex;align-items:center;gap:5px;margin-top:6px;position:relative;z-index:1;
}
.vcard-hint .dot{
  width:6px;height:6px;border-radius:50%;background:#ffb3c6;
  animation:pulse 1.6s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:.4;transform:scale(.8);}50%{opacity:1;transform:scale(1.25);}}

.vcard-back-title{
  font-size:11.5px;font-weight:800;color:#a98bff;letter-spacing:1.4px;
  margin-bottom:8px;display:flex;align-items:center;justify-content:space-between;
}
.ex-item{margin-bottom:9px;padding-left:9px;border-left:3px solid #ffd6e5;}
.ex-item:last-child{margin-bottom:0;}
.ex-cn{
  font-size:13px;font-weight:700;color:#4a3f55;line-height:1.5;
  cursor:pointer;transition:.15s;
}
.ex-cn:hover{color:#a98bff;}
.ex-vn{font-size:11.5px;color:#9b90a8;line-height:1.45;margin-top:2px;font-style:italic;}

/* ============ DIALOGUE ============ */
.dialogue-container {
  max-width: 860px; margin: 0 auto;
  background: rgba(255,255,255,.85); backdrop-filter: blur(10px);
  border-radius: 24px; padding: 24px; box-shadow: 0 10px 30px rgba(180,160,210,.2);
}
.dlg-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 15px;}
.dlg-title { font-size: 20px; font-weight: 800; color: #5d4d70; }
.dlg-controls { display: flex; gap: 10px; flex-wrap: wrap; }
.dlg-btn {
  border: none; padding: 8px 16px; border-radius: 12px; font-weight: 700; cursor: pointer;
  transition: .2s; display: flex; align-items: center; gap: 6px; font-family: inherit;
}
.btn-play { background: #e6dcff; color: #8a6bff; }
.btn-play:hover { background: #d3c1ff; transform: translateY(-2px); }
.btn-stop { background: #ff9dbb; color: #fff; }
.btn-stop:hover { background: #ff7fa3; transform: translateY(-2px); }
.dlg-line { display: flex; gap: 15px; margin-bottom: 16px; align-items: flex-start; transition: .3s; border-radius: 12px; padding: 10px;}
.dlg-line.highlight { background: rgba(255, 227, 238, 0.5); }
.dlg-avatar {
  width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center;
  font-weight: 800; color: #fff; flex: none; font-size: 14px;
}
.avatar-a { background: #ff9dbb; }
.avatar-b { background: #a98bff; }
.avatar-c { background: #7fdcc0; }
.dlg-content { flex: 1; }
.dlg-zh { font-size: 17px; font-weight: 700; color: #4a3f55; margin-bottom: 4px; cursor: pointer; display: inline-block;}
.dlg-zh:hover { color: #a98bff; }
.dlg-py { font-size: 14px; color: #a08fc4; font-weight: 600; margin-bottom: 4px; }
.dlg-vn { font-size: 14px; color: #8d8298; font-style: italic; }

/* ============ GRAMMAR ============ */
.grammar-list { display: flex; flex-direction: column; gap: 18px; max-width: 860px; margin: 0 auto; }
.grammar-card {
  background: rgba(255,255,255,.88); backdrop-filter: blur(10px);
  border-radius: 22px; padding: 20px 24px; box-shadow: 0 8px 26px rgba(180,160,210,.16);
  border-top: 5px solid #a98bff;
}
.gr-title { font-size: 18px; font-weight: 800; color: #5d4d70; margin: 0 0 6px 0; }
.gr-formula {
  display: inline-block; background: #f3edff; color: #8a6bff;
  padding: 4px 12px; border-radius: 8px; font-weight: 700; font-size: 15px;
  margin-bottom: 10px; border: 1px dashed #c9b6ff;
}
.gr-desc { font-size: 14px; color: #7a6b88; margin-bottom: 16px; line-height: 1.5; }
.gr-ex-list { display: flex; flex-direction: column; gap: 10px; }
.gr-ex-item {
  display: flex; align-items: flex-start; justify-content: space-between;
  padding: 12px 14px; background: #fdfafc; border-radius: 12px;
  border: 1px solid #f0e6f7; transition: .2s;
}
.gr-ex-item:hover { border-color: #c9b6ff; background: #fff; }
.gr-ex-content { flex: 1; }
.gr-ex-zh { font-size: 16px; font-weight: 700; color: #4a3f55; margin-bottom: 3px; }
.gr-ex-py { font-size: 13px; color: #a08fc4; margin-bottom: 3px; }
.gr-ex-vn { font-size: 13px; color: #8d8298; font-style: italic; }
.gr-spk {
  flex: none; width: 32px; height: 32px; border-radius: 50%;
  border: none; background: #e6dcff; color: #8a6bff; font-size: 16px;
  cursor: pointer; display: grid; place-items: center; transition: .2s; margin-left: 12px;
}
.gr-spk:hover { background: #d3c1ff; transform: scale(1.1); }

/* ============ WRITING ============ */
.write-panel-container{display:flex;flex-direction:column;gap:20px;max-width:900px;margin:0 auto;}
.word-select-card{width:100%;}
.word-select-card select#charSelect{max-width:500px;}
.write-wrap{display:flex;gap:24px;flex-wrap:wrap;justify-content:center;align-items:flex-start;}
.write-stage{
  position:relative;width:min(420px,88vw);aspect-ratio:1/1;flex:none;
  border-radius:26px;overflow:hidden;background:rgba(255,255,255,.88);
  box-shadow:0 12px 36px rgba(180,160,210,.22),inset 0 0 0 2px rgba(255,255,255,.9);
  touch-action:none;
}
.grid-svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:1;}
.hanzi-anim{position:absolute;inset:0;z-index:2;display:grid;place-items:center;pointer-events:none;}
.trace-char{
  position:absolute;inset:0;display:grid;place-items:center;z-index:2;
  font-size:min(300px,64vw);font-weight:400;color:#f3e9f7;
  user-select:none;pointer-events:none;line-height:1;font-family:"KaiTi","STKaiti","Kaiti SC",serif;
  transition:opacity .25s;
}
#writeCanvas{position:absolute;inset:0;width:100%;height:100%;cursor:crosshair;touch-action:none;z-index:3;}
.write-side{flex:1;min-width:260px;max-width:390px;display:flex;flex-direction:column;gap:16px;}
.wcard{background:rgba(255,255,255,.8);backdrop-filter:blur(10px);border-radius:22px;padding:18px;box-shadow:0 8px 26px rgba(180,160,210,.16);}
.wcard h3{margin:0 0 12px;font-size:14px;color:#7a6b88;letter-spacing:1px;font-weight:800;}
select#charSelect{width:100%;padding:11px 14px;border-radius:14px;border:2px solid #f0e6f7;font-size:16px;font-family:inherit;background:#fff;color:#4a3f55;outline:none;cursor:pointer;}
select#charSelect:focus{border-color:#c9b6ff;}
.char-chips{display:flex;gap:9px;flex-wrap:wrap;margin-top:13px;}
.char-chip{border:none;cursor:pointer;width:56px;height:56px;border-radius:15px;font-size:29px;line-height:1;color:#7a6b88;font-family:"KaiTi","STKaiti","Kaiti SC",serif;background:#fff;box-shadow:0 4px 14px rgba(180,160,210,.2);transition:.22s cubic-bezier(.34,1.56,.64,1);}
.char-chip:hover{transform:translateY(-3px);color:#5d4d70;}
.char-chip.active{color:#fff;background:linear-gradient(135deg,#ff9dbb,#a98bff);box-shadow:0 7px 20px rgba(169,139,255,.45);transform:translateY(-2px) scale(1.05);}
.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px;}
.btn{border:none;cursor:pointer;font-family:inherit;font-weight:700;font-size:14px;padding:10px 18px;border-radius:14px;transition:.2s;color:#fff;background:linear-gradient(135deg,#a98bff,#8a6bff);box-shadow:0 5px 16px rgba(169,139,255,.35);}
.btn:hover{transform:translateY(-2px);filter:brightness(1.06);}
.btn:active{transform:scale(.96);}
.btn.ghost{background:rgba(255,255,255,.92);color:#8a7d95;box-shadow:0 4px 14px rgba(180,160,210,.18);}
.btn.ghost:hover{color:#5d4d70;}
.btn.pink{background:linear-gradient(135deg,#ff9dbb,#ff7fa3);box-shadow:0 5px 16px rgba(255,127,163,.35);}
.btn.mint{background:linear-gradient(135deg,#7fdcc0,#4fc3a1);box-shadow:0 5px 16px rgba(79,195,161,.35);}
.color-row{display:flex;gap:9px;align-items:center;flex-wrap:wrap;}
.swatch{width:28px;height:28px;border-radius:50%;cursor:pointer;border:3px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.13);transition:.2s;}
.swatch:hover{transform:scale(1.12);}
.swatch.active{box-shadow:0 0 0 3px #a98bff;transform:scale(1.12);}

/* ============ GAME (WORD NINJA & MEMORY) ============ */
.mode-toggle { display: flex; justify-content: center; gap: 10px; margin-bottom: 15px; }
.mode-btn { border: none; padding: 10px 20px; border-radius: 20px; font-weight: 700; cursor: pointer; transition: .2s; background: rgba(255,255,255,.6); color: #7a6b88; }
.mode-btn.active { background: #a98bff; color: #fff; box-shadow: 0 4px 12px rgba(169,139,255,.4); }

.game-wrapper {
  display: flex; flex-direction: column; align-items: center;
  background: #000; border-radius: 24px; overflow: hidden;
  box-shadow: 0 16px 44px rgba(0,0,0,.5);
  width: 100%; max-width: 860px; margin: 0 auto; position: relative;
}
.game-hud {
  width: 100%; display: flex; justify-content: space-between; align-items: center;
  padding: 15px 25px; position: absolute; top: 0; left: 0; z-index: 10;
  background: linear-gradient(to bottom, rgba(0,0,0,0.8), transparent);
  color: #fff; font-family: "Segoe UI", sans-serif; font-weight: bold; pointer-events: none;
}
.game-hud-left { display: flex; gap: 20px; font-size: 20px; text-shadow: 0 2px 4px rgba(0,0,0,0.5); }
.btn-pause {
  pointer-events: auto; background: rgba(255,255,255,0.2); border: 2px solid #fff;
  color: #fff; border-radius: 50%; width: 40px; height: 40px; display: grid; place-items: center;
  font-size: 18px; cursor: pointer; transition: 0.2s;
}
.btn-pause:hover { background: rgba(255,255,255,0.4); transform: scale(1.1); }
.combo-badge {
  position: absolute; top: 60px; right: 25px; font-size: 24px; color: #ffcc00;
  font-weight: 900; opacity: 0; transform: scale(0.5); transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  text-shadow: 0 0 10px rgba(255,204,0,0.8); pointer-events: none; z-index: 10;
}
.combo-badge.active { opacity: 1; transform: scale(1); }
#gameCanvas {
  display: block; width: 100%; height: 500px;
  background: radial-gradient(circle at center, #1a2a40 0%, #0a0f18 100%);
  touch-action: none; cursor: crosshair;
}
.game-overlay {
  position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center;
  background: rgba(0,0,0,0.75); backdrop-filter: blur(5px); z-index: 20; transition: opacity 0.3s;
}
.game-overlay.hidden { opacity: 0; pointer-events: none; }
.game-overlay h2 { color: #fff; font-size: 36px; margin-bottom: 10px; text-shadow: 0 0 20px rgba(255,255,255,0.5); }
.game-overlay p { color: #ccc; margin-bottom: 30px; font-size: 18px; text-align: center;}
.btn-restart {
  background: linear-gradient(135deg, #ff9dbb, #a98bff); color: #fff; border: none;
  padding: 12px 30px; font-size: 18px; font-weight: bold; border-radius: 30px; cursor: pointer;
  box-shadow: 0 10px 20px rgba(169,139,255,0.4); transition: 0.2s;
}
.btn-restart:hover { transform: translateY(-3px); filter: brightness(1.1); }

/* MEMORY GAME STYLES */
#memory-game-container { width: 100%; height: 500px; background: #fdf1f7; display: none; padding: 20px; overflow-y: auto; position: relative;}
.mem-board { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; max-width: 500px; margin: 0 auto; }
.mem-card { aspect-ratio: 1/1; perspective: 1000px; cursor: pointer; }
.mem-inner { position: relative; width: 100%; height: 100%; transform-style: preserve-3d; transition: transform 0.5s; }
.mem-card.flipped .mem-inner { transform: rotateY(180deg); }
.mem-front, .mem-back { position: absolute; width: 100%; height: 100%; backface-visibility: hidden; border-radius: 12px; display: flex; flex-direction: column; justify-content: center; align-items: center; font-weight: bold; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
.mem-front { background: linear-gradient(135deg,#a98bff,#8a6bff); color: #fff; font-size: 28px; }
.mem-back { background: #fff; color: #3d3346; transform: rotateY(180deg); border: 2px solid #a98bff; padding: 5px; text-align: center;}
.mem-back .cn { font-size: 24px; color: #ff7fa3; }
.mem-back .py { font-size: 14px; color: #8b7bb8; margin-top: 4px; }
.mem-card.matched { pointer-events: none; opacity: 0.5; }

/* ============ EXERCISES ============ */
.ex-panel{max-width:860px;margin:0 auto;}
.ex-intro{background:rgba(255,255,255,.78);backdrop-filter:blur(10px);border-radius:20px;padding:16px 20px;margin-bottom:18px;box-shadow:0 8px 26px rgba(180,160,210,.16);display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;}
.ex-intro h2{margin:0;font-size:19px;color:#5d4d70;letter-spacing:.6px;}
.ex-intro p{margin:4px 0 0;font-size:13px;color:#8d8298;}
.ex-score{background:linear-gradient(135deg,#fff0f6,#f3edff);border-radius:14px;padding:9px 18px;font-weight:800;color:#a98bff;font-size:15px;white-space:nowrap;box-shadow:0 4px 12px rgba(169,139,255,.2);}

/* Ex 1: Fill in the blank */
.word-bank{background:rgba(255,255,255,.82);backdrop-filter:blur(10px);border-radius:20px;padding:14px 18px;margin-bottom:18px;box-shadow:0 8px 26px rgba(180,160,210,.14);}
.word-bank h3{margin:0 0 10px;font-size:13px;color:#7a6b88;letter-spacing:1px;font-weight:800;}
.bank-chips{display:flex;flex-wrap:wrap;gap:9px;}
.bank-chip{padding:7px 15px;border-radius:999px;font-size:15px;font-weight:700;background:#fff;color:#7a6b88;border:2px solid #f0e6f7;box-shadow:0 3px 10px rgba(180,160,210,.14);transition:.2s;cursor:default;user-select:none;display:flex;flex-direction:column;align-items:center;}
.bank-chip .py{font-size:11px;color:#a08fc4;}
.fill-list{display:flex;flex-direction:column;gap:14px;}
.fill-item{background:rgba(255,255,255,.86);backdrop-filter:blur(8px);border-radius:18px;padding:16px 18px;box-shadow:0 6px 20px rgba(180,160,210,.14);display:flex;gap:12px;align-items:flex-start;border-left:5px solid #ffd6e5;transition:.3s;}
.fill-item.correct{border-left-color:#7fdcc0;background:rgba(240,255,250,.9);}
.fill-item.wrong{border-left-color:#ff7fa3;background:rgba(255,244,248,.9);}
.fill-num{flex:none;width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#ffb3c6,#c9b6ff);color:#fff;display:grid;place-items:center;font-weight:800;font-size:13px;box-shadow:0 3px 10px rgba(201,182,255,.4);}
.fill-body{flex:1;line-height:2.2;font-size:16px;color:#4a3f55;display:flex;flex-direction:column;gap:6px;}
.fill-body .cn { font-weight: 700; }
.fill-body .py { font-size: 13px; color: #a08fc4; font-style: italic; margin-bottom: 6px;}
.fill-body select{font-family:inherit;font-size:15px;font-weight:700;padding:5px 10px;border-radius:11px;border:2px solid #e6d8ff;background:#fff;color:#6f5f9c;outline:none;cursor:pointer;min-width:120px;transition:.2s;vertical-align:middle;}
.fill-body select:focus{border-color:#a98bff;box-shadow:0 0 0 3px rgba(169,139,255,.2);}
.fill-body select.ok{border-color:#4fc3a1;color:#2e8b6f;background:#f0fff9;}
.fill-body select.no{border-color:#ff7fa3;color:#c94a72;background:#fff5f8;}
.ex-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:20px;justify-content:center;}
.ex-result{margin-top:16px;text-align:center;font-weight:800;font-size:17px;min-height:26px;color:#a98bff;letter-spacing:.5px;}

/* Ex 2: Multiple Choice */
.mc-list{display:flex;flex-direction:column;gap:14px;}
.mc-item{background:rgba(255,255,255,.86);backdrop-filter:blur(8px);border-radius:18px;padding:16px 18px;box-shadow:0 6px 20px rgba(180,160,210,.14);border-left:5px solid #d9cbff;transition:.3s;}
.mc-item.correct{border-left-color:#7fdcc0;background:rgba(240,255,250,.9);}
.mc-item.wrong{border-left-color:#ff7fa3;background:rgba(255,244,248,.9);}
.mc-q{font-size:16px;font-weight:700;color:#4a3f55;line-height:1.5;margin-bottom:4px;}
.mc-q-py{font-size:14px;color:#a08fc4;font-style:italic;margin-bottom:12px;}
.mc-q .blank{display:inline-block;min-width:64px;border-bottom:2.5px dashed #a98bff;color:#a98bff;text-align:center;margin:0 4px;font-weight:900;}
.mc-options{display:grid;grid-template-columns:repeat(2,1fr);gap:9px;}
.mc-option{border:2px solid #f0e6f7;background:#fff;border-radius:13px;padding:10px 13px;font-family:inherit;font-size:15px;font-weight:700;color:#6f6180;cursor:pointer;text-align:left;transition:.2s;display:flex;flex-direction:column;}
.mc-option:hover:not(:disabled){border-color:#c9b6ff;color:#5d4d70;transform:translateY(-1px);}
.mc-option:disabled{cursor:default;}
.mc-option.ok{border-color:#4fc3a1;background:#eafaf4;color:#2e8b6f;}
.mc-option.no{border-color:#ff7fa3;background:#fff0f5;color:#c94a72;}
.mc-option.dim{opacity:.55;}
.mc-option .py{color:#a08fc4;font-size:13px;font-weight:600;margin-top:2px;}

/* Ex 3: Word Ordering */
.order-list{display:flex;flex-direction:column;gap:16px;}
.order-item{background:rgba(255,255,255,.86);backdrop-filter:blur(8px);border-radius:18px;padding:16px 18px;box-shadow:0 6px 20px rgba(180,160,210,.14);border-left:5px solid #ffc2d6;}
.order-item.correct{border-left-color:#7fdcc0;background:rgba(240,255,250,.9);}
.order-item.wrong{border-left-color:#ff7fa3;background:rgba(255,244,248,.9);}
.order-q{font-size:15px;color:#8d8298;margin-bottom:12px;font-style:italic;}
.order-ans-area{min-height:48px;border-bottom:2px dashed #e6d8ff;display:flex;flex-wrap:wrap;gap:8px;padding:8px 0;margin-bottom:12px;}
.order-pool{display:flex;flex-wrap:wrap;gap:8px;}
.order-word{background:#fff;border:2px solid #f0e6f7;padding:6px 14px;border-radius:12px;font-size:15px;font-weight:700;color:#6f6180;cursor:pointer;transition:.2s;display:flex;flex-direction:column;align-items:center;}
.order-word .py{font-size:11px;color:#a08fc4;}
.order-word:hover{border-color:#c9b6ff;transform:translateY(-2px);}
.order-word.used{opacity:0;pointer-events:none;}

@media (max-width:600px){
  .wrap{padding:14px 12px 50px;}
  .grid{grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:11px;}
  .vcard{height:260px;}
  .vcard-hanzi{font-size:25px;}
  .ex-cn{font-size:12px;}
  .ex-vn{font-size:10.8px;}
  #gameCanvas, #memory-game-container{height: 400px;}
  .mc-options{grid-template-columns:1fr;}
  .fill-body{font-size:15px;}
  .mem-board { grid-template-columns: repeat(3, 1fr); }
}
</style>
</head>
