const ex3List = document.getElementById('ex3List');
const ex3Score = document.getElementById('ex3Score');
let ex3Total = EX3_DATA.length;
document.getElementById('ex3Total').textContent = ex3Total;
let ex3State = [];

function renderEx3() {
  ex3State = EX3_DATA.map(item => ({
    ans: item.ans,
    selected: [],
    pool: shuffleArray([...item.words]) // Sử dụng Fisher-Yates để đảm bảo hoàn toàn ngẫu nhiên
  }));

  ex3List.innerHTML = EX3_DATA.map((item, idx) => {
    const poolHtml = ex3State[idx].pool.map((w, i) => `<div class="order-word" data-idx="${idx}" data-word="${w.t}" data-pos="${i}"><span>${w.t}</span><span class="py">${w.p}</span></div>`).join('');
    return `<div class="order-item" data-idx="${idx}">
      <div class="order-q">${item.hint}</div>
      <div class="order-ans-area" id="order-ans-${idx}"></div>
      <div class="order-pool" id="order-pool-${idx}">${poolHtml}</div>
    </div>`;
  }).join('');
  
  ex3Score.textContent = '0';
  document.getElementById('ex3Result').textContent = '';

  // Click logic
  ex3List.querySelectorAll('.order-word').forEach(wordEl => {
    wordEl.addEventListener('click', () => {
      sfxClick();
      const idx = parseInt(wordEl.dataset.idx);
      const word = wordEl.dataset.word;
      
      wordEl.classList.add('used');
      ex3State[idx].selected.push(word);
      
      const ansArea = document.getElementById(`order-ans-${idx}`);
      const span = document.createElement('div');
      span.className = 'order-word';
      span.innerHTML = wordEl.innerHTML;
      span.style.background = '#eafaf4';
      span.style.borderColor = '#7fdcc0';
      
      span.addEventListener('click', () => {
        sfxClick();
        span.remove();
        ex3State[idx].selected = ex3State[idx].selected.filter(w => w !== word);
        const allPool = document.querySelectorAll(`.order-word[data-idx="${idx}"][data-word="${word}"]`);
        for(let el of allPool) { if(el.classList.contains('used')) { el.classList.remove('used'); break; } }
      });
      ansArea.appendChild(span);
    });
  });
}

document.getElementById('ex3Check').addEventListener('click', () => {
  sfxClick();
  let correct = 0;
  ex3State.forEach((state, idx) => {
    const itemEl = ex3List.querySelector(`.order-item[data-idx="${idx}"]`);
    const userAns = state.selected.join('');
    
    if (state.ans.includes(userAns)) {
      itemEl.classList.add('correct');
      itemEl.classList.remove('wrong');
      correct++;
    } else {
      itemEl.classList.add('wrong');
      itemEl.classList.remove('correct');
    }
  });
  
  ex3Score.textContent = correct;
  const res = document.getElementById('ex3Result');
  if (correct === ex3Total) {
    res.textContent = '🎉 Tuyệt vời! Bạn đã sắp xếp đúng hết!';
    res.style.color = '#2e8b6f';
  } else {
    res.textContent = `Bạn đúng ${correct}/${ex3Total} câu. Cố lên!`;
    res.style.color = '#ff7fa3';
  }
});

document.getElementById('ex3Reset').addEventListener('click', () => { sfxClick(); renderEx3(); });
renderEx3();

</script>
