        if (ov === item.ans) o.classList.add('ok');
        else if (ov === val && val !== item.ans) o.classList.add('no');
        else o.classList.add('dim');
      });
      
      if (val === item.ans) itemEl.classList.add('correct');
      else itemEl.classList.add('wrong');
      
