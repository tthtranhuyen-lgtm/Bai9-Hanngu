let width, height;
function resizeCanvas() {
  const rect = canvasGame.getBoundingClientRect();
  width = rect.width;
  height = rect.height;
  canvasGame.width = width;
  canvasGame.height = height;
}
window.addEventListener('resize', resizeCanvas);
setTimeout(resizeCanvas, 100);

class FruitItem {
  constructor(wordObj) {
    this.text = wordObj.h;
    this.pinyin = wordObj.p;
    this.radius = 45;
    this.x = Math.random() * (width - this.radius * 2) + this.radius;
    this.y = height + this.radius;
    this.vx = (width / 2 - this.x) * (0.5 + Math.random() * 0.5) / 100;
    this.vy = -(9 + Math.random() * 3);
    this.gravity = 0.15;
    this.rotation = Math.random() * Math.PI * 2;
    this.vr = (Math.random() - 0.5) * 0.1;
    this.color = Math.floor(Math.random() * 360);
    this.isSliced = false;
  }
  update() {
    this.x += this.vx;
    this.y += this.vy;
    this.vy += this.gravity;
    this.rotation += this.vr;
  }
  draw(ctx) {
    ctx.save();
    ctx.translate(this.x, this.y);
    ctx.rotate(this.rotation);
    ctx.beginPath();
    ctx.arc(0, 0, this.radius, 0, Math.PI * 2);
    ctx.fillStyle = `hsla(${this.color}, 80%, 60%, 0.2)`;
    ctx.fill();
    ctx.lineWidth = 3;
    ctx.strokeStyle = `hsla(${this.color}, 90%, 70%, 1)`;
    ctx.shadowBlur = 15;
    ctx.shadowColor = `hsla(${this.color}, 90%, 70%, 1)`;
    ctx.stroke();
    ctx.shadowBlur = 0; 
    ctx.fillStyle = '#fff';
    ctx.font = 'bold 28px "Microsoft YaHei", sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(this.text, 0, -5);
    ctx.fillStyle = `hsla(${this.color}, 90%, 80%, 1)`;
    ctx.font = 'bold 14px "Segoe UI", sans-serif';
    ctx.fillText(this.pinyin, 0, 20);
    ctx.restore();
  }
}

class SliceHalf {
  constructor(x, y, color, text, side, angle) {
    this.x = x;
    this.y = y;
    this.color = color;
    this.text = text;
    this.side = side; 
    this.angle = angle;
    this.vx = Math.cos(angle) * 5 + (side === 1 ? -3 : 3);
    this.vy = Math.sin(angle) * 5 - 2;
    this.gravity = 0.2;
    this.rotation = 0;
    this.vr = (Math.random() - 0.5) * 0.2;
    this.life = 1.0;
  }
  update() {
    this.x += this.vx;
    this.y += this.vy;
    this.vy += this.gravity;
    this.rotation += this.vr;
    this.life -= 0.015;
  }
  draw(ctx) {
    if (this.life <= 0) return;
    ctx.save();
    ctx.translate(this.x, this.y);
    ctx.rotate(this.rotation);
    ctx.globalAlpha = this.life;
    ctx.beginPath();
    if (this.side === 1) {
      ctx.arc(0, 0, 45, Math.PI/2, Math.PI*1.5);
    } else {
      ctx.arc(0, 0, 45, Math.PI*1.5, Math.PI/2);
    }
    ctx.fillStyle = `hsla(${this.color}, 80%, 60%, 0.4)`;
    ctx.fill();
    ctx.strokeStyle = `hsla(${this.color}, 90%, 70%, 1)`;
    ctx.lineWidth = 3;
    ctx.stroke();
    ctx.restore();
  }
}

class JuiceParticle {
  constructor(x, y, color) {
    this.x = x;
    this.y = y;
    this.vx = (Math.random() - 0.5) * 15;
    this.vy = (Math.random() - 0.5) * 15 - 3;
    this.color = color;
    this.life = 1.0;
    this.gravity = 0.3;
    this.size = Math.random() * 4 + 2;
  }
  update() {
    this.x += this.vx;
    this.y += this.vy;
    this.vy += this.gravity;
    this.life -= 0.03;
  }
  draw(ctx) {
    if (this.life <= 0) return;
    ctx.globalAlpha = this.life;
    ctx.beginPath();
    ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
    ctx.fillStyle = `hsla(${this.color}, 90%, 70%, 1)`;
    ctx.fill();
    ctx.globalAlpha = 1;
  }
}

const ninjaGame = {
  running: false, gameOver: false, isPaused: false, score: 0, lives: 3,
  fruits: [], halves: [], particles: [], trail: [],
  spawnTimer: 0, spawnInterval: 1000, lastTime: 0, rafId: null,
  lastSliceTime: 0, combo: 0, comboTimeout: 700, 
  
  reset() {
    this.score = 0; this.lives = 3; this.fruits = []; this.halves = []; this.particles = []; this.trail = [];
    this.combo = 0; this.running = true; this.gameOver = false; this.isPaused = false; this.spawnTimer = 0; this.lastTime = performance.now();
    uiScore.textContent = '0'; uiLives.textContent = '3'; uiCombo.classList.remove('active');
    uiOverlay.classList.add('hidden'); uiPauseOverlay.classList.add('hidden');
    if (this.rafId) cancelAnimationFrame(this.rafId);
    this.rafId = requestAnimationFrame(this.loop.bind(this));
  },
  pause() {
    if (!this.running || this.isPaused) return;
    this.isPaused = true; this.running = false;
    if (this.rafId) cancelAnimationFrame(this.rafId);
    uiPauseOverlay.classList.remove('hidden');
  },
  resume() {
    if (this.isPaused) {
      this.isPaused = false; this.running = true; this.lastTime = performance.now();
      uiPauseOverlay.classList.add('hidden');
      this.rafId = requestAnimationFrame(this.loop.bind(this));
    }
  },
  loop(time) {
    if (!this.running || this.isPaused) return;
    let dt = time - this.lastTime;
    this.lastTime = time;
    this.update(dt);
    this.draw();
    this.rafId = requestAnimationFrame(this.loop.bind(this));
  },
  update(dt) {
    this.spawnTimer -= dt;
    if (this.spawnTimer <= 0 && this.fruits.length < 6) {
      const w = GAME_WORDS[Math.floor(Math.random() * GAME_WORDS.length)];
      this.fruits.push(new FruitItem(w));
      this.spawnTimer = this.spawnInterval + (Math.random() * 500 - 250);
    }
    for (let i = this.fruits.length - 1; i >= 0; i--) {
      const f = this.fruits[i]; f.update();
      if (f.y > height + f.radius && f.vy > 0) {
        this.fruits.splice(i, 1); this.loseLife();
      }
    }
    for (let i = this.halves.length - 1; i >= 0; i--) {
      const h = this.halves[i]; h.update();
      if (h.life <= 0) this.halves.splice(i, 1);
    }
    for (let i = this.particles.length - 1; i >= 0; i--) {
      const p = this.particles[i]; p.update();
      if (p.life <= 0) this.particles.splice(i, 1);
    }
    if (this.trail.length > 0) {
      for (let i = this.trail.length - 1; i >= 0; i--) {
        this.trail[i].life -= dt * 0.003;
        if (this.trail[i].life <= 0) this.trail.splice(i, 1);
      }
    }
    if (this.combo > 0 && performance.now() - this.lastSliceTime > this.comboTimeout) {
      this.combo = 0; uiCombo.classList.remove('active');
    }
  },
  draw() {
    ctxGame.clearRect(0, 0, width, height);
    if (this.trail.length > 1) {
      ctxGame.beginPath();
      ctxGame.moveTo(this.trail[0].x, this.trail[0].y);
      for (let i = 1; i < this.trail.length; i++) ctxGame.lineTo(this.trail[i].x, this.trail[i].y);
      ctxGame.strokeStyle = 'rgba(255, 255, 255, 0.8)'; ctxGame.lineWidth = 6;
      ctxGame.lineCap = 'round'; ctxGame.lineJoin = 'round';
      ctxGame.shadowBlur = 15; ctxGame.shadowColor = '#fff';
      ctxGame.stroke(); ctxGame.shadowBlur = 0;
      ctxGame.strokeStyle = 'rgba(200, 240, 255, 1)'; ctxGame.lineWidth = 2; ctxGame.stroke();
    }
    this.fruits.forEach(f => f.draw(ctxGame));
    this.halves.forEach(h => h.draw(ctxGame));
    this.particles.forEach(p => p.draw(ctxGame));
  },
  loseLife() {
    if (!this.running || this.isPaused) return;
    this.lives--; uiLives.textContent = this.lives; sfxMiss();
    canvasGame.style.boxShadow = 'inset 0 0 50px rgba(255,0,0,0.5)';
    setTimeout(() => canvasGame.style.boxShadow = 'none', 300);
    if (this.lives <= 0) {
      this.gameOver = true; this.running = false;
      document.getElementById('ui-title').textContent = 'Game Over!';
      document.getElementById('ui-desc').innerHTML = `Điểm của bạn: <b>${this.score}</b>`;
      uiOverlay.classList.remove('hidden');
    }
  },
  checkSlice(x1, y1, x2, y2) {
    if (!this.running || this.isPaused) return;
    const dist = Math.hypot(x2 - x1, y2 - y1);
    const steps = Math.max(1, Math.ceil(dist / 10)); 
    for (let i = 0; i <= steps; i++) {
      const t = i / steps;
      const cx = x1 + (x2 - x1) * t;
      const cy = y1 + (y2 - y1) * t;
      for (let j = this.fruits.length - 1; j >= 0; j--) {
        const f = this.fruits[j];
        if (Math.hypot(cx - f.x, cy - f.y) < f.radius) {
          this.sliceFruit(f, Math.atan2(y2 - y1, x2 - x1));
          this.fruits.splice(j, 1);
        }
      }
    }
  },
  sliceFruit(f, angle) {
    sfxSliceSound(); speak(f.text);
    const now = performance.now();
    if (now - this.lastSliceTime < this.comboTimeout) this.combo++; else this.combo = 1;
    this.lastSliceTime = now;
    const points = this.combo > 1 ? 10 * this.combo : 10;
    this.score += points; uiScore.textContent = this.score;
    if (this.combo > 1) {
      uiCombo.textContent = `COMBO x${this.combo}!`; uiCombo.classList.add('active');
      uiCombo.style.animation = 'none'; uiCombo.offsetHeight; uiCombo.style.animation = null; 
    }
    this.halves.push(new SliceHalf(f.x, f.y, f.color, f.text, 1, angle));
    this.halves.push(new SliceHalf(f.x, f.y, f.color, f.text, 2, angle));
    for (let i = 0; i < 15; i++) this.particles.push(new JuiceParticle(f.x, f.y, f.color));
  }
};

let isPointerDown = false;
let lastPointerPos = null;
function handlePointerMove(e) {
  if (!ninjaGame.running || ninjaGame.isPaused) return;
  const rect = canvasGame.getBoundingClientRect();
  let clientX = e.touches ? e.touches[0].clientX : e.clientX;
  let clientY = e.touches ? e.touches[0].clientY : e.clientY;
  const x = clientX - rect.left; const y = clientY - rect.top;
  if (lastPointerPos) {
    if (isPointerDown || e.type === 'mousemove') {
      ninjaGame.checkSlice(lastPointerPos.x, lastPointerPos.y, x, y);
      ninjaGame.trail.push({ x, y, life: 1.0 });
      if (ninjaGame.trail.length > 20) ninjaGame.trail.shift();
    }
  }
  lastPointerPos = { x, y };
}
canvasGame.addEventListener('mousedown', () => { isPointerDown = true; lastPointerPos = null; });
canvasGame.addEventListener('mouseup', () => { isPointerDown = false; lastPointerPos = null; });
canvasGame.addEventListener('mouseleave', () => { isPointerDown = false; lastPointerPos = null; });
canvasGame.addEventListener('mousemove', handlePointerMove);
canvasGame.addEventListener('touchstart', (e) => { e.preventDefault(); isPointerDown = true; lastPointerPos = null; handlePointerMove(e); }, {passive: false});
canvasGame.addEventListener('touchmove', (e) => { e.preventDefault(); handlePointerMove(e); }, {passive: false});
canvasGame.addEventListener('touchend', (e) => { e.preventDefault(); isPointerDown = false; lastPointerPos = null; }, {passive: false});

uiPauseBtn.addEventListener('click', () => { ninjaGame.pause(); sfxClick(); });
uiResume.addEventListener('click', () => { ninjaGame.resume(); sfxClick(); });
uiRestart.addEventListener('click', () => { resizeCanvas(); ninjaGame.reset(); sfxClick(); });
ninjaGame.gameOver = true;


/* ===== MEMORY GAME LOGIC ===== */
let memFirstCard, memSecondCard, memLockBoard = false, memMatches = 0;

function initMemoryGame() {
  const board = document.getElementById('memBoard');
  board.innerHTML = '';
  document.getElementById('mem-overlay').classList.add('hidden');
  memMatches = 0;
  
  // Lấy ngẫu nhiên 8 từ
  const selected = [...GAME_WORDS].sort(() => 0.5 - Math.random()).slice(0, 8);
  let cards = [];
  selected.forEach(w => {
    cards.push({ id: w.h, type: 'hanzi', text: w.h });
    cards.push({ id: w.h, type: 'pinyin', text: w.p });
  });
  cards.sort(() => 0.5 - Math.random());

  cards.forEach(c => {
    const cardEl = document.createElement('div');
    cardEl.className = 'mem-card';
    cardEl.dataset.id = c.id;
    cardEl.innerHTML = `
      <div class="mem-inner">
        <div class="mem-front">?</div>
        <div class="mem-back">
          <span class="${c.type === 'hanzi' ? 'cn' : 'py'}">${c.text}</span>
        </div>
      </div>`;
    cardEl.addEventListener('click', flipCard);
    board.appendChild(cardEl);
  });
}

function flipCard() {
  if (memLockBoard) return;
  if (this === memFirstCard) return;
  
  this.classList.add('flipped');
  if (!memFirstCard) {
    memFirstCard = this;
    return;
  }
  memSecondCard = this;
  checkForMatch();
}

function checkForMatch() {
  const isMatch = memFirstCard.dataset.id === memSecondCard.dataset.id;
  if (isMatch) {
    disableCards();
  } else {
    unflipCards();
  }
}

function disableCards() {
  memFirstCard.classList.add('matched');
  memSecondCard.classList.add('matched');
  memMatches++;
  sfxClick();
  if (memMatches === 8) {
    setTimeout(() => {
      document.getElementById('mem-overlay').classList.remove('hidden');
    }, 500);
  }
  resetBoard();
}

function unflipCards() {
  memLockBoard = true;
  setTimeout(() => {
    memFirstCard.classList.remove('flipped');
    memSecondCard.classList.remove('flipped');
    resetBoard();
  }, 1000);
}

function resetBoard() {
  [memFirstCard, memSecondCard, memLockBoard] = [null, null, false];
}

document.getElementById('mem-restart').addEventListener('click', () => {
  sfxClick();
  initMemoryGame();
});


