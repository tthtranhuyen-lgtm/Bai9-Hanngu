// TỪ ĐIỂN ÉP PHÁT ÂM (Sửa lỗi đa âm từ và ngắt âm)
const PRONUNCIATION_FIX = {
  '一会儿': '等一会儿', // Thêm "đợi" để ép đọc liền âm r (yí huìr)
  '数': '数一数'        // Thêm "một chút" để ép đọc thanh 3 (shǔ yī shǔ)
};

function speak(text, type = 'default', rateOverride = null) {
  if(!('speechSynthesis' in window)) return;
  window.speechSynthesis.cancel();
  
  let speakText = text;
  let customRate = rateOverride || (type === 'dlg' ? dlgRate : speechRate);

  // Áp dụng ép phát âm
  if (PRONUNCIATION_FIX[text]) {
    speakText = PRONUNCIATION_FIX[text];
  }

  const u = new SpeechSynthesisUtterance(speakText);
  u.lang = 'zh-CN';
  u.rate = customRate;
  u.pitch = 1.0;

  // Lọc giọng
  const CANTONESE = ['sinji','cantonese','yue','zh-hk','zh_hk','hong kong'];
  const validVoices = availableVoices.filter(v => {
    const lang = (v.lang || '').toLowerCase().replace('_','-');
    const name = (v.name || '').toLowerCase();
    const isCanto = CANTONESE.some(b => lang.includes(b) || name.includes(b));
    return !isCanto && (lang.includes('zh') || name.includes('chinese') || name.includes('mandarin'));
  });

  let selectedVoice = null;

  if (type === 'male') {
    selectedVoice = validVoices.find(v => v.name.includes('Yunxi') || v.name.includes('Yunyang') || v.name.includes('Kangkang') || v.name.includes('Male'));
    u.pitch = 0.8;
  } else if (type === 'female') {
    selectedVoice = validVoices.find(v => v.name.includes('Xiaoxiao') || v.name.includes('Xiaoyi') || v.name.includes('Ting-Ting') || v.name.includes('Mei-Jia') || v.name.includes('Yaoyao') || v.name.includes('Huihui'));
    u.pitch = 1.25;
  } else {
    selectedVoice = validVoices.find(v => v.name.includes('Xiaoxiao') || v.name.includes('Ting-Ting') || v.name.includes('Huihui') || v.name.includes('Google 普通话'));
    u.pitch = 1.1;
  }

  if (selectedVoice) u.voice = selectedVoice;

  if (text === '多少') {
    u.rate = 0.7; 
  }

  window.speechSynthesis.speak(u);
}

/* ---- SFX ---- */
let audioCtx = null;
function getAudio(){
  if(!audioCtx){ try{ audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }catch(e){} }
  if(audioCtx && audioCtx.state === 'suspended'){ try{ audioCtx.resume(); }catch(e){} }
  return audioCtx;
}
function sfxSliceSound(){
  const ac = getAudio(); if(!ac) return;
  const t = ac.currentTime;
  const o = ac.createOscillator(), g = ac.createGain();
  o.type = 'sine';
  o.frequency.setValueAtTime(1200, t);
  o.frequency.exponentialRampToValueAtTime(300, t + 0.1);
  g.gain.setValueAtTime(0.001, t);
  g.gain.linearRampToValueAtTime(0.2, t + 0.01);
  g.gain.exponentialRampToValueAtTime(0.001, t + 0.1);
  o.connect(g).connect(ac.destination);
  o.start(t); o.stop(t + 0.12);
}
function sfxMiss(){
  const ac = getAudio(); if(!ac) return;
  const t = ac.currentTime;
  const o = ac.createOscillator(), g = ac.createGain();
  o.type = 'square'; o.frequency.setValueAtTime(200, t); o.frequency.exponentialRampToValueAtTime(80, t + 0.3);
  g.gain.setValueAtTime(0.001, t); g.gain.linearRampToValueAtTime(0.1, t + 0.02); g.gain.exponentialRampToValueAtTime(0.001, t + 0.3);
  o.connect(g).connect(ac.destination); o.start(t); o.stop(t + 0.32);
}
function sfxClick(){
  const ac = getAudio(); if(!ac) return;
  const t = ac.currentTime;
  const o = ac.createOscillator(), g = ac.createGain();
  o.type = 'sine'; o.frequency.value = 660;
  g.gain.setValueAtTime(0.001, t); g.gain.linearRampToValueAtTime(0.08, t + 0.01); g.gain.exponentialRampToValueAtTime(0.001, t + 0.12);
  o.connect(g).connect(ac.destination); o.start(t); o.stop(t + 0.14);
}

/* Hàm hỗ trợ xáo trộn mảng (Fisher-Yates) */
function shuffleArray(array) {
  for (let i = array.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [array[i], array[j]] = [array[j], array[i]];
  }
  return array;
}

